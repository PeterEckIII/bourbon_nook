{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "lint": "vp lint .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vp preview",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "vp exec playwright test",
    "test:e2e:ui": "vp exec playwright test --ui",
    "test:e2e:report": "vp exec playwright show-report",
    "generate:api": "orval --config orval.config.ts",
    "generate:bottles-api": "orval --config orval.config.ts --project bottlesApi",
    "generate:users-api": "orval --config orval.config.ts --project usersApi",
    "generate:reviews-api": "orval --config orval.config.ts --project reviewsApi"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-table": "^9.0.0",
    "axios": "^1.19.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@neodrag/core": "3.0.0-next.11",
    "@playwright/test": "^1.62.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-form-devtools": "^0.2.32",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/router-core": "^1.171.16",
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "catalog:",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.8.1",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "orval": "^8.23.0",
    "rolldown": "1.2.3",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "yarn",
      "version": "4.18.0",
      "onFail": "download"
    }
  }
}
