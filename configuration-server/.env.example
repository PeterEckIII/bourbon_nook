# Copy to .env in this directory and fill in real values.
CONFIG_SERVER_USERNAME_ADMIN=
CONFIG_SERVER_PASSWORD_ADMIN=
# These CLIENT credentials are what every other service authenticates with --
# they must match the CONFIG_SERVER_USERNAME / CONFIG_SERVER_PASSWORD values
# in every other service's own .env file.
CONFIG_SERVER_USERNAME_CLIENT=
CONFIG_SERVER_PASSWORD_CLIENT=
GIT_REPO=
GIT_TOKEN=
GIT_USERNAME=
RABBIT_MQ_USERNAME=
RABBIT_MQ_PASSWORD=
# Spring Cloud Config's symmetric encryption key (used to decrypt {cipher}
# values served from the config repo). Was previously hardcoded in
# bootstrap.properties -- move that same value here.
ENCRYPT_KEY=
